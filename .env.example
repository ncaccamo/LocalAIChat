# Copy to .env and edit before first run:  cp .env.example .env
# Backend selection (local vs remote, vulkan vs rocm7) lives in
# backend.env — see backend.env.example.

# Model files, looked up inside the mounted models dir (~/llm_models).
# If the file is absent the container downloads it once (gpt-oss-20b
# ~12 GB, coder ~10.5 GB); see docker/entrypoint.sh for the source URLs.
CHAT_MODEL_FILE=gpt-oss-20b.gguf
CODE_MODEL_FILE=Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf

# Run the container as your host user so downloaded models aren't root-owned.
HOST_UID=1000
HOST_GID=1000

# GPU device group IDs on this host — check with: getent group video render
VIDEO_GID=44
RENDER_GID=992

# Host port for the Open WebUI. Change it if 3000 is already in use on this
# system (e.g. a homelab box running another dashboard). URL becomes
# http://localhost:<OWUI_PORT>.
OWUI_PORT=3000

# Open WebUI auth. true = login required (account created on first visit).
WEBUI_AUTH=true
# Registration. Closed by default — the first account (yours) is admin.
# Set true only if you need to create another account, then set it back.
ENABLE_SIGNUP=false

# Chat model context window. Raised from 8192 for web-search retrieval
# headroom. gpt-oss-20b + a 16384 KV cache fits the 16 GB card; re-check
# VRAM (drop toward 12288) if you switch the chat model.
CHAT_CTX=16384

# --- Web search -------------------------------------------------------------
# Opt-in per chat session via the message-bar toggle in Open WebUI; this
# only decides whether that toggle exists. When a user turns it on, the
# query + fetched pages leave this machine via a self-hosted SearXNG
# container (no third-party search API). Set false to remove the toggle.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=10
