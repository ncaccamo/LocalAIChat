# Copy to .env and edit before first run:  cp .env.example .env
# Backend selection (local vs remote, vulkan vs rocm7) lives in
# backend.env — see backend.env.example.

# Model files, looked up inside the mounted models dir (~/llm_models).
# If the file is absent the container downloads it once (gpt-oss-20b
# ~12 GB, coder ~10.5 GB); see docker/entrypoint.sh for the source URLs.
CHAT_MODEL_FILE=gpt-oss-20b.gguf
CODE_MODEL_FILE=Qwen2.5-Coder-14B-Instruct-Q5_K_M.gguf

# Run the container as your host user so downloaded models aren't root-owned.
HOST_UID=1000
HOST_GID=1000

# GPU device group IDs on this host — check with: getent group video render
VIDEO_GID=44
RENDER_GID=992

# Host port for the Open WebUI. Change it if 3000 is already in use on this
# system (e.g. a homelab system running another dashboard). URL becomes
# http://localhost:<OWUI_PORT>.
OWUI_PORT=3000

# Open WebUI auth. true = login required (account created on first visit).
WEBUI_AUTH=true
# Registration. Closed by default — the first account (yours) is admin.
# Set true only if you need to create another account, then set it back.
ENABLE_SIGNUP=false

# Chat model context window. Raised from 8192 for web-search retrieval
# headroom. gpt-oss-20b + a 16384 KV cache fits the 16 GB card; re-check
# VRAM (drop toward 12288) if you switch the chat model.
CHAT_CTX=16384

# --- Web search -------------------------------------------------------------
# Opt-in per chat session via the message-bar toggle in Open WebUI; this
# only decides whether that toggle exists. When a user turns it on, the
# query + fetched pages leave this machine via a self-hosted SearXNG
# container (no third-party search API). Set false to remove the toggle.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_RESULT_COUNT=3
WEB_SEARCH_CONCURRENT_REQUESTS=10

# --- Open WebUI interface / background generation ---------------------------
# All env-authoritative (ENABLE_PERSISTENT_CONFIG=false) — the Admin UI
# toggles for these won't persist, so change them here. The *_GENERATION
# flags each trigger a hidden model call; the ones off by default keep the
# one loaded model (or the hybrid CPU fallback) free for actual chat.
ENABLE_FOLLOW_UP_GENERATION=false     # the "suggested follow-ups" under replies
ENABLE_TAGS_GENERATION=false          # auto-tagging of chats
ENABLE_AUTOCOMPLETE_GENERATION=false  # ghost-text in the input box
ENABLE_TITLE_GENERATION=true          # auto-name chats (kept on)
ENABLE_SEARCH_QUERY_GENERATION=true   # rewrites your msg into a search query (kept on)
ENABLE_COMMUNITY_SHARING=false        # removes the "share to openwebui.com" button
ENABLE_USER_WEBHOOKS=false
ENABLE_DIRECT_CONNECTIONS=false       # no user-added API endpoints in personal settings
ENABLE_OLLAMA_API=false               # OpenAI path only; skip boot-time Ollama probe
# New-chat splash prompt cards. "[]" clears them; a JSON array sets your own.
OWUI_PROMPT_SUGGESTIONS=[]

# --- Image generation (optional) ---------------------------------------------
# A second backend on the remote GPU system -- this repo doesn't run or
# install it; see docs/remote-gpu.md "Image generation" for what to set up
# there. Off by default (nothing answers at the URL below on a fresh clone).
ENABLE_IMAGE_GENERATION=false
IMAGE_GENERATION_ENGINE=automatic1111   # a wire protocol, not the legacy AUTOMATIC1111 webui
AUTOMATIC1111_BASE_URL=                 # e.g. http://192.168.89.51:7860
# Off: image requests go straight to the diffusion model, no chat model
# involved. Set true for LLM-expanded prompts, at the cost of an extra
# model swap on the remote if it's also serving chat/code.
ENABLE_IMAGE_PROMPT_GENERATION=false
