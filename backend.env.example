# LocalAIChat backend selection.  Copy to backend.env:
#   cp backend.env.example backend.env
# scripts/start.sh reads this, validates it, and decides what to launch.
#
# backend.env is gitignored (it can hold REMOTE_API_KEY).
# Keep KEY=value lines clean -- no trailing inline comments. Related to
# BookTranslator's backend.env by convention, not kept identical: the
# shared concepts (BACKEND_MODE, LLAMA_BACKEND, REMOTE_*) stay aligned,
# but `hybrid` is LocalAIChat-only.

# local | hybrid | remote
BACKEND_MODE=local

# ---------- BACKEND_MODE=local ----------
# Which prebuilt llama.cpp backend the model-server container runs:
#   vulkan   - default; works on any Vulkan 1.3+ GPU (binary llama-server-vulkan)
#   rocm7    - ROCm 7.2.4 stable HIP build (binary llama-server-rocm)
#   rocm714  - ROCm 7.14 preview: NOT built into the image (parked). Selecting
#              it fails fast. See BackendBuildstage/ROCM714_NOTES.md.
# Switching vulkan <-> rocm7 is a stop/start only -- no image rebuild.
LLAMA_BACKEND=vulkan

# ---------- BACKEND_MODE=remote ----------
# Point Open WebUI at a llama-server on another LAN machine (e.g.
# llama-server.exe on a Windows gaming PC using its GPU via Vulkan). In
# remote mode the model-server container is NOT started -- nothing runs
# locally. The remote can still hot-swap models if it runs its own
# llama-swap.
REMOTE_HOST=
REMOTE_PORT=11500
REMOTE_API_KEY=

# ---------- BACKEND_MODE=hybrid ----------
# Remote GPU (the REMOTE_* block above) PLUS an always-on CPU chat model
# in the local model-server container, so the dropdown is never empty
# when the remote box is powered off. Open WebUI queries both endpoints
# and merges them; the GPU models just disappear while the box is down.
# The local side always runs the portable cpu llama.cpp binary --
# LLAMA_BACKEND is ignored in hybrid.
#
# FALLBACK_MODEL_FILE  - .gguf in the models dir; downloaded on first run
#                        if absent. Chat / general-purpose only (a CPU
#                        coder is too slow to be useful). Swap to a 7B for
#                        better standalone knowledge at lower tok/s.
# FALLBACK_CTX         - context window for that model (CPU RAM, not VRAM).
FALLBACK_MODEL_FILE=Qwen2.5-3B-Instruct-Q4_K_M.gguf
FALLBACK_CTX=8192
