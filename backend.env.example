# LocalAIChat backend selection.  Copy to backend.env:
#   cp backend.env.example backend.env
# scripts/start.sh reads this, validates it, and decides what to launch.
# Same schema as BookTranslator's backend.env (duplicated by convention,
# not shared via any file).

BACKEND_MODE=local            # local | remote

# ===================== local mode =====================
# Which prebuilt llama.cpp backend the model-server container runs.
#   vulkan   - default; works on any Vulkan 1.3+ GPU (binary llama-server-vulkan)
#   rocm7    - ROCm 7.2.4 stable HIP build (binary llama-server-rocm)
#   rocm714  - ROCm 7.14 preview: NOT built into the image (parked). Selecting
#              it fails fast. See BackendBuildstage/ROCM714_NOTES.md.
# Switching vulkan <-> rocm7 is a stop/start only - no image rebuild.
LLAMA_BACKEND=vulkan

# ===================== remote mode ====================
# Point Open WebUI at a llama-server running on another LAN machine
# (e.g. llama-server.exe on a Windows gaming PC, using its GPU via Vulkan).
# In remote mode the model-server container is NOT started - nothing runs
# locally, and there is no model hot-swap (the remote serves whatever model
# it was launched with).
REMOTE_HOST=                  # e.g. 192.168.1.50
REMOTE_PORT=11500
REMOTE_API_KEY=               # must match --api-key passed to the remote llama-server
